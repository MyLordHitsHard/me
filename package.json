{
  "name": "lifeos",
  "version": "1.0.0",
  "description": "LifeOS — a multi-user career & life dashboard: skills, exams, workouts, notes, sketches, people, relations, analytics, SWOT and opt-in leaderboards.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://lifeos:lifeos@localhost:5432/lifeos_test} node --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
